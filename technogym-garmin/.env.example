# Identifiants Mywellness : OPTIONNELS. La page web (http://127.0.0.1:8000) les demande et peut les garder
# en local dans data/credentials.json. Ne les mettre ici que pour l'API / le job planifie sans interface.
MYWELLNESS_EMAIL=
MYWELLNESS_PASSWORD=

# Identifiants Garmin Connect : OPTIONNELS (meme remarque). Jetons persistes dans GARTH_HOME.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARTH_HOME=./data/garth

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Cle admin pour POST /auth/pair et POST /garmin/push-today (laisser vide pour desactiver la protection)
ADMIN_TOKEN=
# Base SQLite pour tokens d'appairage et resultats de seance
DATABASE_PATH=./data/backend.sqlite3
# Fuseau horaire du job quotidien (push Garmin a 6h)
TZ=Europe/Paris
PUSH_HOUR=6

# Renvoi experimental des resultats vers Mywellness (StartWorkoutSession / SavePerformedPhysicalActivity /
# CloseWorkoutSession). 0 = stockage local uniquement (defaut), 1 = tenter l'ecriture.
MYWELLNESS_WRITEBACK=0
# Programme decrit a la main (secours si l'API Mywellness change). Voir examples/program_override.example.yaml
PROGRAM_OVERRIDE_PATH=
# Duree de cache du programme prescrit (secondes)
PROGRAM_CACHE_TTL=300

# Debug / demo : force la date du jour pour /workout/today (YYYY-MM-DD), vide en usage normal
TODAY_OVERRIDE=
