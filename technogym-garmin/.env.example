# Identifiants Mywellness (compte utilisateur de l'app web endusernext.mywellness.com)
MYWELLNESS_EMAIL=you@example.com
MYWELLNESS_PASSWORD=change-me

# Identifiants Garmin Connect (login garth, jetons persistes dans GARTH_HOME)
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=change-me
GARTH_HOME=./data/garth

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Cle admin pour POST /auth/pair et POST /garmin/push-today (laisser vide pour desactiver la protection)
ADMIN_TOKEN=
# Base SQLite pour tokens d'appairage et resultats de seance
DATABASE_PATH=./data/backend.sqlite3
# Fuseau horaire du job quotidien (push Garmin a 6h)
TZ=Europe/Paris
PUSH_HOUR=6
